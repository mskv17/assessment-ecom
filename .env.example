# Public Configuration Only — Never commit real secrets or private keys
# Base URL for the future REST API backend
VITE_API_BASE_URL=https://api.harvesthearth.com/v1

# Data mode: "true" to use local mock data provider, "false" to call live HTTP API
VITE_USE_MOCK_DATA=true

# Simulated network latency in milliseconds for realistic loading states in mock mode
VITE_MOCK_NETWORK_LATENCY_MS=350

# Enable diagnostic logging of CRO analytics events (view_item, add_to_cart, etc.)
VITE_ENABLE_ANALYTICS_LOGS=true
